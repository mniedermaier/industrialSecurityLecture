# Docker bind-mount stub the landing service creates at runtime.
bachelor/labs/_stack/landing/labs/

# Lab artefacts captured during runs (PCAPs, Zeek logs).
# Keep the directories themselves via .gitkeep, not the contents.
bachelor/labs/_stack/captures/*
!bachelor/labs/_stack/captures/.gitkeep
bachelor/labs/_stack/zeek-logs/*
!bachelor/labs/_stack/zeek-logs/.gitkeep
